{
  "mode": {
    "type": "string",
    "description": "工作模式",
    "hint": "silent 只记账；push 变化时推一句；look 只给模型工具、按需看；both 两者都开。默认 silent。",
    "options": [
      "silent",
      "push",
      "look",
      "both"
    ],
    "default": "silent"
  },
  "target_umo": {
    "type": "string",
    "description": "推送到哪个会话",
    "hint": "只在 silent/push/both 下用于推送；look 模式不需要。留空则不采样。",
    "default": ""
  },
  "sample_seconds": {
    "type": "float",
    "description": "采样间隔（秒）",
    "hint": "每隔这么久掷一次骰子，命中才真的截屏。调小会明显增加开销。",
    "default": 300
  },
  "prob_percent": {
    "type": "int",
    "description": "命中概率（0-100）",
    "hint": "与采样间隔相乘就是实际看图频率。默认 20，即平均每五轮看一眼。",
    "default": 20
  },
  "model": {
    "type": "string",
    "description": "视觉模型名",
    "hint": "Ollama 里已有的多模态模型，例如 qwen3-vl:4b。",
    "default": "qwen3-vl:4b"
  },
  "ollama_url": {
    "type": "string",
    "description": "Ollama 地址",
    "default": "http://127.0.0.1:11434"
  },
  "shot_dir": {
    "type": "string",
    "description": "截图目录",
    "hint": "留空则放在插件数据目录下的 shots。",
    "default": ""
  },
  "log_path": {
    "type": "string",
    "description": "观察日志路径",
    "default": ""
  },
  "status_path": {
    "type": "string",
    "description": "状态文件路径",
    "default": ""
  },
  "state_path": {
    "type": "string",
    "description": "最近一次看见的状态文件",
    "hint": "eye_state.json，供外部读取；留空放在插件数据目录。",
    "default": ""
  },
  "enable": {
    "type": "bool",
    "description": "旧开关（仅兼容）",
    "hint": "新配置请用 mode。只有 mode 缺省时才参考它：true 视为 push。",
    "invisible": true,
    "default": false
  }
}